# bge-m3 modeli imaja GÖMÜLÜ TEI imajı.
# Neden: sunucudaki bozuk proxy env'i, TEI'nin çalışma anında HuggingFace'ten model
# indirmesini engelliyor. Modeli derleme anında (iyi internetli makinenizde) indirip
# gömeriz; sunucuda TEI /model'den yükler, HF'e hiç bağlanmaz → proxy sorunu tamamen biter.
#
# ÖNEMLİ: TEI'nin CPU imajı ONNX backend kullanır (safetensors değil), bu yüzden bge-m3'ün
# onnx/ ağırlıkları gömülür (model.onnx + harici veri dosyaları).
#
# Derleme (kendi makinenizde):
#   cd siraj-backend
#   docker buildx build --platform linux/amd64 -f Dockerfile.embeddings \
#     -t metehancelik/siraj-embeddings:latest --push .

FROM python:3.12-slim AS downloader
RUN pip install --no-cache-dir "huggingface_hub[cli]"
# Root config/tokenizer/pooling + onnx ağırlıkları (model.onnx dış veri dosyalarına muhtaç)
RUN hf download BAAI/bge-m3 --local-dir /model \
      config.json \
      tokenizer.json \
      tokenizer_config.json \
      special_tokens_map.json \
      sentencepiece.bpe.model \
      config_sentence_transformers.json \
      sentence_bert_config.json \
      modules.json \
      1_Pooling/config.json \
      onnx/model.onnx \
      onnx/model.onnx_data \
      onnx/Constant_7_attr__value
# Doğrulama: kritik dosyalar var mı (yoksa build patlasın)
RUN test -f /model/onnx/model.onnx && test -f /model/onnx/model.onnx_data \
      && test -f /model/1_Pooling/config.json && test -f /model/config.json \
      && test -f /model/tokenizer.json

FROM ghcr.io/huggingface/text-embeddings-inference:cpu-1.5
COPY --from=downloader /model /model
CMD ["--model-id", "/model"]
