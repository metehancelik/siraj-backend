# TEI image with the bge-m3 model BAKED IN.
# Why: the broken proxy env on the server stops TEI from downloading the model from
# HuggingFace at runtime. We download and bake the model in at build time (on your machine
# with good internet); on the server TEI loads from /model and never contacts HF → the
# proxy problem goes away entirely.
#
# IMPORTANT: TEI's CPU image uses the ONNX backend (not safetensors), so bge-m3's onnx/
# weights are baked in (model.onnx + external data files).
#
# Build (on your own machine):
#   cd siraj-backend
#   docker buildx build --platform linux/amd64 -f Dockerfile.embeddings \
#     -t metehancelik/siraj-embeddings:latest --push .

FROM python:3.12-slim AS downloader
RUN pip install --no-cache-dir "huggingface_hub[cli]"
# Root config/tokenizer/pooling + onnx weights (model.onnx needs its external data files)
RUN hf download BAAI/bge-m3 --local-dir /model \
      config.json \
      tokenizer.json \
      tokenizer_config.json \
      special_tokens_map.json \
      sentencepiece.bpe.model \
      config_sentence_transformers.json \
      sentence_bert_config.json \
      modules.json \
      1_Pooling/config.json \
      onnx/model.onnx \
      onnx/model.onnx_data \
      onnx/Constant_7_attr__value
# Check: are the critical files present (fail the build if not)
RUN test -f /model/onnx/model.onnx && test -f /model/onnx/model.onnx_data \
      && test -f /model/1_Pooling/config.json && test -f /model/config.json \
      && test -f /model/tokenizer.json

FROM ghcr.io/huggingface/text-embeddings-inference:cpu-1.5
COPY --from=downloader /model /model
CMD ["--model-id", "/model"]
