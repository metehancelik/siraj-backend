# --- Postgres (pgvector) ---
# You can use your existing VPS Postgres; it only needs the 'vector' extension (schema.sql installs it).
DATABASE_URL=postgresql://siraj:CHANGEME@localhost:5432/siraj

# --- Embedding service (bge-m3) ---
# bge-m3 runs on a server (TEI). The backend can reach it in two ways:
#
# MODE 1 (openai): through your LiteLLM gateway - same gateway/key as gemma.
#   Register TEI in LiteLLM as "bge-m3" (README > embedding), then:
EMBEDDING_MODE=openai
EMBEDDING_BASE_URL=https://ai.ravey.app/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=sk-zRNCLZqMVQFLIoGNDnVkrA
#
# MODE 2 (tei): straight to TEI (no LiteLLM, fastest; ideal for ingest).
#   EMBEDDING_MODE=tei and the TEI address:
EMBEDDING_URL=http://embeddings:80
#
EMBEDDING_DIM=1024
# bge-m3 needs no prefix. Set true if you use multilingual-e5-large (query:/passage: prefixes).
EMBEDDING_USE_E5_PREFIX=false

# --- LLM (your own endpoint, OpenAI compatible) ---
# On a CPU server 12B is too slow for chat; switch to a small model (README > "CPU-only").
# E.g. Gemma 3 4B (Q4_K_M) or Qwen2.5-7B-Instruct.
LLM_BASE_URL=https://ai.ravey.app/v1
LLM_API_KEY=sk-zRNCLZqMVQFLIoGNDnVkrA
LLM_MODEL=gemma-4-12b

# --- Retrieval / latency settings (kept small for CPU) ---
# Final number of passages given to the LLM after candidate selection (CPU: 2-3)
TOP_K=3
# Number of candidates fetched from each of vector and full-text search
CANDIDATE_K=20
# Max characters of a passage that enter the context (caps token cost; CPU: 450-600)
MAX_CHUNK_CHARS=550
# Max tokens the LLM generates (keep it short on CPU; each token ~0.1-0.5 s)
LLM_MAX_TOKENS=320
LLM_TEMPERATURE=0.3

# The corpus is Turkish. Non-Turkish questions are translated into Turkish before search;
# when measured, searching English queries directly did not work (the relevance threshold
# does not discriminate, Turkish FTS never matches). The cost is an extra ~3-3.5 s LLM call
# per question (repeats come from the cache). If set to false, translation is skipped and
# the relevance gate is disabled for non-Turkish questions.
TRANSLATE_QUERIES=true

# --- Backend access key (the mobile app sends this Bearer) ---
# If left empty, authentication is off (development only).
API_TOKEN=

# CORS (usually unnecessary for mobile; * is fine for web testing)
CORS_ORIGINS=*
