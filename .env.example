# --- Postgres (pgvector) ---
# Mevcut VPS Postgres'inizi kullanabilirsiniz; sadece 'vector' eklentisi gerekir (schema.sql kuruyor).
DATABASE_URL=postgresql://siraj:CHANGEME@localhost:5432/siraj

# --- Embedding servisi (bge-m3) ---
# bge-m3 bir sunucuda (TEI) koşar. Backend ona iki şekilde erişebilir:
#
# MOD 1 (openai): LiteLLM gateway'iniz üzerinden — gemma ile aynı kapı/anahtar.
#   TEI'yi LiteLLM'e "bge-m3" olarak kaydedin (README > embedding), sonra:
EMBEDDING_MODE=openai
EMBEDDING_BASE_URL=https://ai.ravey.app/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=sk-zRNCLZqMVQFLIoGNDnVkrA
#
# MOD 2 (tei): TEI'ye doğrudan (LiteLLM'siz, en hızlı; ingest için ideal).
#   EMBEDDING_MODE=tei ve TEI adresi:
EMBEDDING_URL=http://embeddings:80
#
EMBEDDING_DIM=1024
# bge-m3 önek istemez. multilingual-e5-large kullanırsanız true yapın (query:/passage: önekleri).
EMBEDDING_USE_E5_PREFIX=false

# --- LLM (kendi endpoint'iniz, OpenAI uyumlu) ---
# CPU sunucuda 12B sohbet için çok yavaş; küçük bir modele geçin (README > "CPU-only").
# Örn. Gemma 3 4B (Q4_K_M) veya Qwen2.5-7B-Instruct.
LLM_BASE_URL=https://ai.ravey.app/v1
LLM_API_KEY=sk-zRNCLZqMVQFLIoGNDnVkrA
LLM_MODEL=gemma-4-12b

# --- Retrieval / gecikme ayarları (CPU için küçük tutuldu) ---
# Adaydan sonra LLM'e verilecek nihai pasaj sayısı (CPU: 2-3)
TOP_K=3
# Vektör ve tam-metin aramasının her birinden çekilecek aday sayısı
CANDIDATE_K=20
# Bir pasajın bağlama girecek azami karakteri (token maliyetini sınırlar; CPU: 450-600)
MAX_CHUNK_CHARS=550
# LLM'in üreteceği azami token (CPU'da kısa tutun; her token ~0.1-0.5 sn)
LLM_MAX_TOKENS=320
LLM_TEMPERATURE=0.3

# Korpüs Türkçe. Türkçe olmayan sorular aramadan önce Türkçeye çevrilir; ölçüldüğünde
# İngilizce sorguları doğrudan aratmak çalışmıyordu (alaka eşiği ayırt etmiyor, Türkçe
# FTS hiç eşleşmiyor). Bedeli soru başına ~3-3,5 sn ek LLM çağrısı (tekrarlar önbellekten).
# false yapılırsa çeviri atlanır ve Türkçe olmayan sorularda alaka kapısı devre dışı kalır.
TRANSLATE_QUERIES=true

# --- Backend erişim anahtarı (mobil uygulama bu Bearer'ı gönderir) ---
# Boş bırakırsanız kimlik doğrulama kapalı olur (sadece geliştirme için).
API_TOKEN=

# CORS (mobil için genelde gereksiz; web test için * bırakılabilir)
CORS_ORIGINS=*
